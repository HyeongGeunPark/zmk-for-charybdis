if SHIELD_CHARYBDIS_DONGLE

config ZMK_KEYBOARD_NAME
	default "Charybdis"

# The dongle is the only central. Both halves are peripherals, so neither
# sets this any more.
config ZMK_SPLIT_ROLE_CENTRAL
	default y

# The peripheral count lives in charybdis_dongle.conf as
# ZMK_SPLIT_ESB_PERIPHERAL_COUNT; the BLE-side counts and connection limits
# are gone along with BLE.

endif

if SHIELD_CHARYBDIS_LEFT || SHIELD_CHARYBDIS_RIGHT || SHIELD_CHARYBDIS_DONGLE

config ZMK_SPLIT
	default y

endif
