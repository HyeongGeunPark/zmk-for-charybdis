#include "charybdis.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
}; 

&kscan0 {
	col-gpios
		= <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};

// trackball bus
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            /* PMW3610 drives a single bidirectional SDIO line, so MOSI and
               MISO share P0.17. */
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        cpi = <400>;

        /* The sensor is mounted rotated. That fix-up now happens in the
           sensor's own orientation register instead of in driver code. The
           previous software mapping was (x, y) = (-raw_y, -raw_x), i.e. a
           swap plus both axes inverted. Both inversions are applied here, so
           this holds whether the chip inverts before or after the swap. */
        swap-xy;
        invert-x;
        invert-y;

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /*
         * The base chain is plain pointer motion. Holding a mode key on the
         * Pointer layer activates a layer whose only effect is to swap in a
         * different chain here.
         *
         * These have to be the raw layer numbers. Devicetree is preprocessed
         * before Kconfig, so this cannot live in charybdis.keymap behind a
         * CONFIG_SHIELD_CHARYBDIS_RIGHT guard -- such a guard is always false
         * and silently drops the whole block. Keep in sync with the SCROLL
         * and SNIPE defines in charybdis.keymap.
         */
        scroller {
            /* SCROLL */
            layers = <4>;
            /* Map the two axes onto the wheels, then require several counts
               per wheel tick. 24 is where the old drag scroll ended up. */
            input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 24>;
            /* If scrolling runs the wrong way, insert
               <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT> after the mapper. */
        };

        sniper {
            /* SNIPE */
            layers = <5>;
            /* Half speed, matching the old driver's 200 CPI snipe mode
               against its 400 CPI default. */
            input-processors = <&zip_xy_scaler 1 2>;
        };
    };
};


//RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <27>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

